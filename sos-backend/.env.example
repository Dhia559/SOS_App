# Copie ce fichier en .env et remplis les valeurs.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sos_club
DB_USER=postgres
DB_PASSWORD=

SERVER_PORT=8080
JWT_SECRET=change-me-with-a-long-random-string-at-least-32-chars
JWT_EXPIRATION_HOURS=24

# Active /api/dev/** (reset des mots de passe du seed). Mettre false en prod.
DEV_ENDPOINTS=true
